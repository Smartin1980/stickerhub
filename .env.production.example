# StickerHub production environment notes
#
# This project is a static frontend. These values are not loaded automatically
# unless a deployment/build step is added later. For the current Hostpoint FTP
# deployment, copy the public values into js/config.js on the production branch
# before uploading.

STICKERHUB_ENV=production
STICKERHUB_SITE_URL=https://stickerhub.bsone.ch
SUPABASE_URL=https://YOUR-PROD-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PROD-PUBLIC-ANON-KEY
