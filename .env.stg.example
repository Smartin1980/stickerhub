# StickerHub stg environment notes
#
# This project is a static frontend. These values are not loaded automatically
# unless a deployment/build step is added later. For the current Hostpoint FTP
# deployment, copy the public values into js/config.js on the stg branch before
# uploading.

STICKERHUB_ENV=stg
STICKERHUB_SITE_URL=https://stickerhub-stg.bsone.ch
SUPABASE_URL=https://YOUR-STG-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-STG-PUBLIC-ANON-KEY
